# Everything here has a working default for local development; this file is
# the list of what a deployment needs to think about. Settings an admin can
# change at runtime — the share-link address, the geocoder, the ZeptoMail
# token and the notification addresses — live in the database instead, under
# Settings in the admin, so changing them needs no redeploy.

# Where the browser reaches the cards. The database value wins if one is set;
# this is the fallback for a fresh install.
PUBLIC_BASE_URL=https://cards.truestaroman.com

# Mark the admin session cookie secure. Must be 1 anywhere served over HTTPS,
# or the session travels in the clear.
COOKIE_SECURE=1

# Who may call the API from a browser. The front end proxies /api/* itself,
# so this is only the origins that talk to the API directly.
CORS_ORIGINS=https://cards.truestaroman.com

# Where the data lives. Both are created on first run.
VCARD_DB=./app.db
VCARD_UPLOADS=./uploads

# Address lookup. Nominatim's policy asks for a real contact address in the
# user agent; Photon needs nothing.
# GEOCODER_USER_AGENT=contact-cards (admin@example.com)
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# PHOTON_URL=https://photon.komoot.io/api
