# Two ways in, one app behind them. The domain gets a certificate of its own —
# Caddy asks for it the first time someone asks for the name — and the bare
# address keeps answering on plain HTTP, for the wait while DNS propagates and
# for anything that still has the IP written down.
#
# Neither needs a cookie setting: the API marks the session cookie Secure by
# how the request arrived, so the same image serves both.

(app) {
	encode zstd gzip

	# The API is routed here rather than through the front end: Next resolves
	# its rewrites when it builds, so a baked-in API address is wrong in every
	# environment but the one that built the image.
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

cards.truestaroman.com {
	import app
}

:80 {
	import app
}
