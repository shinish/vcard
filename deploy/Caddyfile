# Plain HTTP on whatever address the host answers to. No certificate, no
# redirect: the app is reached by its IP while the DNS record is pending.
#
# When cards.truestaroman.com resolves, replace this whole file with a site
# block named after the domain — Caddy then gets its own certificate, and the
# session cookie goes back to being Secure on its own, because the API marks
# the flag from how the request arrived.
:80 {
	encode zstd gzip

	# The API is routed here rather than through the front end: Next resolves
	# its rewrites when it builds, so a baked-in API address is wrong in every
	# environment but the one that built the image.
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
